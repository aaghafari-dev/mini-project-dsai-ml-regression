      <aliases enabled='yes' />
      <column caption='Calculatted_filed_High_Price' datatype='string' name='[Calculation_1836742008975360]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [price] &gt;= 650000 THEN &quot;High Value&quot; ELSE &quot;Standard&quot; END' />
      </column>
      <column caption='Calculatted_filed_YearBuilt' datatype='string' name='[Calculation_1836742009225217]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [yr_built] &gt;= 1900 AND [yr_built] &lt;= 2000 THEN &quot;A (1900-2000)&quot;&#13;&#10;ELSEIF [yr_built] &gt; 2000 AND [yr_built] &lt;= 2010 THEN &quot;B (2000-2010)&quot;&#13;&#10;ELSEIF [yr_built] &gt; 2010 THEN &quot;C (after 2010)&quot;&#13;&#10;END' />
      </column>
